import cv2
img = cv2.imread("belge.jpg")
h, w = img.shape[:2]
merkez = (w // 2, h // 2)
# 34 derece, saat yönünün tersine
M = cv2.getRotationMatrix2D(merkez, 34, 1.0)
donmus = cv2.warpAffine(img, M, (w, h))
cv2.imshow("donmus", donmus)
cv2.waitKey(0)


